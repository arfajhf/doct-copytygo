{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node", "vite/client"],
    "strict": true, "noEmit": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "vite.config.ts"]
}
